{
  "name": "job-autopilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "next dev -p 3100",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx src/worker/index.ts",
    "setup": "tsx scripts/setup.ts",
    "set-password": "tsx scripts/set-password.ts",
    "discover": "tsx scripts/discover.ts",
    "rescore": "tsx scripts/rescore.ts",
    "check-forms": "tsx scripts/check-forms.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:all": "concurrently -k \"npm:start\" \"npm:worker\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "axios": "^1.20.0",
    "docx": "^9.10.0",
    "dotenv": "^18.0.7",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12",
    "mongoose": "^8.24.5",
    "next": "^15.5.27",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
