# Copy to .env (or run `npm run setup`, which creates .env.local from this file and generates AUTH_SECRET).
# Placeholder values only — never commit real secrets.

# --- Required -----------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/job_autopilot

# Random string, 32+ characters. Signs the dashboard session cookie.
AUTH_SECRET=replace-with-a-long-random-string

# Dashboard login password hash. Generate with: npm run set-password -- "your password"
DASHBOARD_PASSWORD_HASH=

# --- AI (local Ollama; leave empty to use the built-in rule-based engine) -------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Only if your Ollama server is behind a proxy or service that requires a key (sent as a Bearer token).
OLLAMA_API_KEY=

# --- Job sources that need credentials (optional) -------------------------------
# Adzuna (free key at https://developer.adzuna.com) — India city searches.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch on RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch) — aggregated listings.
RAPIDAPI_KEY=

# --- Email applications and reminders (optional) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Optional --------------------------------------------------------------------
# Address of this app, used when server actions (action/jobs.ts) call its own API.
API_URL=http://localhost:3100
# Where resume files and generated documents are stored. Defaults to ./data/private.
# DATA_DIR=
# debug | info | warn | error
# LOG_LEVEL=info

# --- Assisted autofill browser ---------------------------------------------------
# Installed browser used by Playwright: msedge or chrome.
BROWSER_CHANNEL=msedge
